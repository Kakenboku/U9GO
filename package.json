{
  "name": "@u9go/uikit",
  "version": "0.1.0",
  "type": "module",
  "description": "A UIKit-style React component and design-system template optimized for Cursor and AI-assisted development. Built with iOS 26 design language.",
  "keywords": [
    "react",
    "typescript",
    "tailwindcss",
    "uikit",
    "components",
    "design-system",
    "ios26",
    "glass-morphism",
    "cursor",
    "ai-development",
    "framer-motion"
  ],
