  "license": "MIT",
  "homepage": "https://kakenboku.github.io/U9GO",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kakenboku/U9GO.git"
  },
  "bugs": {
    "url": "https://github.com/Kakenboku/U9GO/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "VITE_BASE_URL=/U9GO/ tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "deploy": "npm run build:pages && gh-pages -d dist"
  },
  "dependencies": {
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/postcss": "^4.1.11",
    "class-variance-authority": "^0.7.0",
